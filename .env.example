# Copie para .env.local (desenvolvimento) ou cadastre nas variáveis de ambiente da Vercel/Netlify.
# NUNCA coloque aqui a chave secreta (service_role / sb_secret_...): o app se recusa a iniciar com ela.

# Onde os dados ficam: "local" (só neste navegador) ou "supabase".
# Vazio = Supabase se as duas variáveis abaixo existirem; senão, local.
VITE_DATA_MODE=

# Supabase → botão "Connect" do projeto (ou Project Settings → API Keys)
VITE_SUPABASE_URL=
# Chave publicável (sb_publishable_...). A chave "anon" legada também funciona.
VITE_SUPABASE_PUBLISHABLE_KEY=

# "true" mostra "Criar conta" na tela de login. Deixe vazio em produção e cadastre os
# usuários pelo painel do Supabase (Authentication → Users), com o cadastro público desativado.
VITE_ALLOW_SIGNUP=
